{
  "name": "@datacore-one/cli",
  "version": "1.1.0",
  "description": "CLI for setting up and managing Datacore installations",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "datacore": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "datacore",
    "gtd",
    "second-brain",
    "ai",
    "cli"
  ],
  "author": "Datacore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/datacore-one/datacore-cli.git"
  },
  "homepage": "https://github.com/datacore-one/datacore-cli#readme",
  "bugs": {
    "url": "https://github.com/datacore-one/datacore-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "yaml": "^2.3.4",
    "glob": "^11.0.0",
    "simple-git": "^3.22.0",
    "semver": "^7.5.4"
  }
}
